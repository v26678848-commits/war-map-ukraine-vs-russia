<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>Симулятор Карти</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<link rel="stylesheet" href="style.css"/>
</head>
<body>

<div id="menu" class="screen">
  <div class="menu-content">
    <h1>СИМУЛЯТОР КАРТИ</h1>
    <p class="subtitle">Виберіть сторону</p>
    <button class="side-btn ua" data-side="UA">УКРАЇНА</button>
    <button class="side-btn ru" data-side="RU">РОСІЯ</button>
    <div class="menu-actions">
      <button id="btn-load-menu">Завантажити гру</button>
    </div>
    <p class="disclaimer">Це вигадана гра-симуляція. Не є реальними даними.</p>
  </div>
</div>

<div id="game" class="screen hidden">
  <div id="topbar">
    <div class="side-stat ua"><span class="lbl">УКРАЇНА</span><span id="stat-ua">0%</span></div>
    <div class="side-stat ru"><span class="lbl">РОСІЯ</span><span id="stat-ru">0%</span></div>
  </div>

  <div id="map"></div>
  <div id="draw-overlay" class="hidden"></div>

  <div id="controls-right">
    <button class="ctrl" id="btn-zoom-in">+</button>
    <button class="ctrl" id="btn-zoom-out">−</button>
    <button class="ctrl" id="btn-center" title="Центр">◎</button>
    <button class="ctrl" id="btn-draw" title="Малювати">✎</button>
    <button class="ctrl" id="btn-undo" title="Скасувати">↶</button>
    <button class="ctrl" id="btn-settings" title="Меню">☰</button>
  </div>

  <div id="side-picker">
    <button class="side-btn-sm ua" data-side="UA">УКРАЇНА</button>
    <button class="side-btn-sm ru" data-side="RU">РОСІЯ</button>
    <button class="side-btn-sm neutral" data-side="neutral">НЕЙТРАЛЬНО</button>
  </div>

  <div id="stats-panel">
    <div class="stat-row"><b>Контроль території</b></div>
    <div class="stat-row"><span class="dot ua"></span>Україна <b id="st-ua">0%</b></div>
    <div class="stat-row"><span class="dot ru"></span>Росія <b id="st-ru">0%</b></div>
    <div class="stat-row"><span class="dot gray"></span>Сіра зона <b id="st-gray">0%</b></div>
    <div class="stat-row">Захоплено <b id="st-captured">0 км²</b></div>
    <div class="stat-row">Міст <b id="st-cities">0</b></div>
  </div>

  <div id="toast" class="hidden"></div>

  <div id="city-popup" class="hidden">
    <div class="cp-name"></div>
    <div class="cp-region"></div>
    <div class="cp-control"></div>
    <div class="cp-pop"></div>
    <button class="cp-close">×</button>
  </div>

  <div id="settings-panel" class="hidden">
    <h3>Налаштування</h3>
    <button id="set-save">Зберегти гру</button>
    <button id="set-load">Завантажити гру</button>
    <button id="set-reset">Почати заново</button>
    <button id="set-side">Змінити сторону</button>
    <button id="set-close">Закрити</button>
    <div class="hist-title">Історія:</div>
    <div id="history"></div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="gameState.js"></script>
<script src="cities.js"></script>
<script src="grayzone.js"></script>
<script src="territory.js"></script>
<script src="map.js"></script>
<script src="ui.js"></script>
<script src="app.js"></script>
</body>
</html>
